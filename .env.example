# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# Anthropic credentials. Either set a key here, or install the `ant` CLI and run
# `ant auth login`, then leave this blank — the SDK picks up the profile
# automatically. Do not set both.
ANTHROPIC_API_KEY=

# How GATED actions behave. This does NOT change what is gated: reads and
# reversible sandboxed writes always run on their own, and irreversible or
# outward-facing actions are always gated, in both modes.
#
#   interactive = a human is present, so gated actions prompt on the terminal
#   autonomous  = nobody is watching, so gated actions queue for later review
#                 and the agent keeps working on everything else
ASSISTANT_MODE=interactive

# Where the audit log, the pending-approval queue, and the sandbox live.
ASSISTANT_DATA_DIR=./data

# The one directory the agent may write to. Defaults to $ASSISTANT_DATA_DIR/sandbox.
# Point it at a SUBFOLDER of an Obsidian vault to keep a single knowledge base
# while still confining the agent to its own corner — it cannot reach anything
# above this path.
# ASSISTANT_SANDBOX_DIR=~/Documents/MyVault/assistant

# --- Mail (read-only) -------------------------------------------------------
# Leave MAIL_IMAP_HOST blank and the mail server simply does not start.
#
# Point this at a DEDICATED FORWARDING ADDRESS, never your primary mailbox.
# Set up a filter that forwards only the mail you want the assistant to see;
# what it can read is then bounded by that filter, not by code. The mailbox is
# opened read-only and there is no send, reply, or delete tool.
#
# Use an app-specific password, not your account password. Gmail requires one
# (Google Account -> Security -> 2-Step Verification -> App passwords).
MAIL_IMAP_HOST=
MAIL_IMAP_USER=
MAIL_IMAP_PASSWORD=
# MAIL_IMAP_PORT=993
#
# Which folder to read. On Gmail prefer "[Gmail]/All Mail" over INBOX: Gmail
# files some forwarded mail outside the inbox — notably anything you sent from
# the assistant address yourself — and INBOX would silently miss it.
# MAIL_IMAP_FOLDER=[Gmail]/All Mail

# Where the nightly briefing is emailed. Your normal address — this is how an
# unattended sweep reaches you. Sending lives in nightly.py, not in a tool, so
# the agent still has no ability to send mail.
MAIL_DIGEST_TO=
# MAIL_SMTP_HOST=smtp.gmail.com
# MAIL_SMTP_PORT=465

# --- Telegram (approvals) ---------------------------------------------------
# Optional. Leave TELEGRAM_BOT_TOKEN blank and nothing changes: gated actions
# still queue, they just wait in the file until you run `assistant` and use
# /pending. With it set, each queued action arrives on your phone with Approve
# and Deny buttons, and `assistant-approve` executes what you approved.
#
#   1. Message @BotFather, send /newbot, paste the token below
#   2. Send your new bot any message, so it is allowed to reply to you
#   3. uv run assistant-telegram-setup   -> prints your TELEGRAM_CHAT_ID
#
# Sending lives in notify.py, not in a tool, and TELEGRAM_* is stripped from the
# environment every MCP server is launched with — so the agent cannot message
# anyone, and nothing it reads can reach this token.
TELEGRAM_BOT_TOKEN=
#
# This is an ALLOWLIST, not just an address. A bot username is public and anyone
# can press a button at one; only callbacks from this chat id are ever acted on.
TELEGRAM_CHAT_ID=

# Google Calendar, READ-ONLY.
#
# Optional. Leave GOOGLE_CALENDAR_REFRESH_TOKEN blank and the calendar server
# never starts — the agent simply has no calendar tools, which is not the same
# as having broken ones.
#
#   1. Create an OAuth "Desktop app" client in console.cloud.google.com and
#      enable the Google Calendar API (run `uv run assistant-calendar-setup`
#      with no credentials set and it prints the exact steps).
#   2. Put the client id and secret below.
#   3. uv run assistant-calendar-setup   -> prints your refresh token.
#
# The token is requested with the calendar.readonly scope, so this credential
# cannot write to your calendar even if everything else fails. Creating,
# moving and cancelling events are deliberately not built yet; when they are,
# they will be gated like deleting a note.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
# Optional: read a calendar other than your default one (accepts its address).
# GOOGLE_CALENDAR_ID=primary

# Optional overrides.
# ASSISTANT_MODEL=claude-opus-5
# ASSISTANT_EFFORT=high
