# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# Anthropic credentials. Either set a key here, or install the `ant` CLI and run
# `ant auth login`, then leave this blank — the SDK picks up the profile
# automatically. Do not set both.
ANTHROPIC_API_KEY=

# How GATED actions behave. This does NOT change what is gated: reads and
# reversible sandboxed writes always run on their own, and irreversible or
# outward-facing actions are always gated, in both modes.
#
#   interactive = a human is present, so gated actions prompt on the terminal
#   autonomous  = nobody is watching, so gated actions queue for later review
#                 and the agent keeps working on everything else
ASSISTANT_MODE=interactive

# Where the audit log, the pending-approval queue, and the sandbox live.
ASSISTANT_DATA_DIR=./data

# Optional overrides.
# ASSISTANT_MODEL=claude-opus-5
# ASSISTANT_EFFORT=high
